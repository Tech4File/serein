DATABASE_URL=postgres://serein:dev-only-change-me@localhost:5432/serein
LISTEN_ADDR=0.0.0.0:8080
COOKIE_SECURE=false
ALLOWED_WEB_ORIGINS=http://localhost:8080

# OTP mail provider: disabled | api | smtp. Production registration is unavailable until configured.
MAIL_DELIVERY=disabled
MAIL_FROM="Serein <no-reply@example.com>"
# Resend-compatible bearer-authenticated HTTPS API:
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
# SMTP: implicit TLS on 465 or mandatory STARTTLS on 587. Never plaintext.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
